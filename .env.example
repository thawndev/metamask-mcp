# metamask-mcp environment — copy to .env and fill. NEVER commit real values.

# Signer: set ONE of these. A key file must be chmod 600. Keys are held in-process.
MM_PRIVATE_KEY=
MM_PRIVATE_KEY_FILE=

# Chain
MM_NETWORK=1
MM_RPC_URL=https://ethereum-rpc.publicnode.com

# Allow a plaintext/local RPC (dev chains only, e.g. Ganache on 127.0.0.1)
MM_ALLOW_LOCAL_RPC=

# Data dir for the audit log + cache (default: ~/.metamask-mcp)
MM_HOME=
